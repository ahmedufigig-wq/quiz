                if (!isHost) showLobby()
            }
            "players" -> {
                readPlayers(j)
                if (screen == "lobby") refreshPlayers()
            }
            "lobby" -> {
                readPlayers(j)
                if (screen == "lobby") refreshPlayers() else showLobby()
            }
            "error" -> {
                val msg = j.optString("msg", "حدث خطأ")
                leaveAll()
                showHome()
                toast(msg)
            }
            "question" -> showQuestion(j)
            "result" -> showResult(j)
            "final" -> showFinal(j)
        }
    }

    private fun readPlayers(j: JSONObject) {
        val arr = j.optJSONArray("list")
